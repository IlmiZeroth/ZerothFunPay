# Создайте бота через @BotFather и вставьте токен.
TELEGRAM_BOT_TOKEN=

# Ваш числовой Telegram ID. Только этот пользователь сможет управлять ботом.
ADMIN_TELEGRAM_ID=

# Значение cookie golden_key из вашей авторизованной сессии funpay.com.
FUNPAY_GOLDEN_KEY=

# Необязательно: User-Agent того же браузера, из которого взят golden_key.
FUNPAY_USER_AGENT=

# Часовой пояс расписания (название из базы IANA).
TIMEZONE=Europe/Moscow

# Частота проверки событий FunPay. Не рекомендуется ставить меньше 2 секунд.
FUNPAY_POLL_SECONDS=5

# Путь можно оставить без изменений.
DATABASE_PATH=data/bot.sqlite3

